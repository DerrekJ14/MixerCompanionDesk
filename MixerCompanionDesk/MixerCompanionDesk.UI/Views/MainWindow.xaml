<Window x:Class="MixerCompanionDesk.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer Companion Desk"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Mixer Companion Desk" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="Audio routing and device foundation" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Device controls">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Playback device" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding PlaybackDevices}"
                                  SelectedItem="{Binding SelectedPlaybackDevice, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="Recording device" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding RecordingDevices}"
                                  SelectedItem="{Binding SelectedRecordingDevice, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="Master output" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" Margin="18,0,0,0" FontSize="20" FontWeight="SemiBold"
                                       Text="{Binding MasterVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" />

                            <ToggleButton Grid.Row="1" Grid.Column="0" Width="110" HorizontalAlignment="Left"
                                          Margin="0,14,0,0" Padding="12,7" IsChecked="{Binding IsMuted, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding MuteCommand}" Content="Mute" />
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Command="{Binding RefreshDevicesCommand}" Content="Refresh devices" />
                        <Button Command="{Binding LoadSettingsCommand}" Content="Load settings" />
                        <Button Command="{Binding SaveSettingsCommand}" Content="Save settings" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Routing matrix">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Virtual channels" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding MixerChannels}"
                             SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             MinHeight="120" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Selected channel" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <Slider Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ChannelLevel, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Row="2" Margin="0,8,0,0"
                                  IsChecked="{Binding ChannelMuted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="Muted"
                                  Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding RefreshRoutingCommand}" Content="Refresh routing" />
                        <Button Command="{Binding SetMainRouteCommand}" Content="Route to Main" />
                        <Button Command="{Binding ToggleChannelMuteCommand}" Content="Toggle mute" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
