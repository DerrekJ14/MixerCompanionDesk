<Window x:Class="MixerCompanionDesk.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer Companion Desk"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="#101418"
        Foreground="#EAEFF5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1C232D"
                BorderBrush="#2E3945"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Mixer Companion Desk"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F4F8FB" />
                <TextBlock Text="{Binding StatusText, FallbackValue='Ready'}"
                           Margin="0,6,0,0"
                           Foreground="#A8B5C1"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#121A22"
                BorderBrush="#2E3945"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Width="200" Height="220" Margin="8" Background="#1C232D" BorderBrush="#2E3945" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Mic" FontSize="20" FontWeight="SemiBold" Foreground="#F4F8FB" />
                        <TextBlock Text="72%" Margin="0,18,0,0" Foreground="#A8B5C1" FontSize="14" />
                        <ProgressBar Value="72" Height="10" Margin="0,12,0,0" Maximum="100" />
                        <TextBlock Text="Muted: False" Margin="0,16,0,0" Foreground="#A8B5C1" />
                    </StackPanel>
                </Border>

                <Border Width="200" Height="220" Margin="8" Background="#1C232D" BorderBrush="#2E3945" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Game" FontSize="20" FontWeight="SemiBold" Foreground="#F4F8FB" />
                        <TextBlock Text="88%" Margin="0,18,0,0" Foreground="#A8B5C1" FontSize="14" />
                        <ProgressBar Value="88" Height="10" Margin="0,12,0,0" Maximum="100" />
                        <TextBlock Text="Muted: False" Margin="0,16,0,0" Foreground="#A8B5C1" />
                    </StackPanel>
                </Border>

                <Border Width="200" Height="220" Margin="8" Background="#1C232D" BorderBrush="#2E3945" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Music" FontSize="20" FontWeight="SemiBold" Foreground="#F4F8FB" />
                        <TextBlock Text="64%" Margin="0,18,0,0" Foreground="#A8B5C1" FontSize="14" />
                        <ProgressBar Value="64" Height="10" Margin="0,12,0,0" Maximum="100" />
                        <TextBlock Text="Muted: False" Margin="0,16,0,0" Foreground="#A8B5C1" />
                    </StackPanel>
                </Border>

                <Border Width="200" Height="220" Margin="8" Background="#1C232D" BorderBrush="#2E3945" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Browser" FontSize="20" FontWeight="SemiBold" Foreground="#F4F8FB" />
                        <TextBlock Text="48%" Margin="0,18,0,0" Foreground="#A8B5C1" FontSize="14" />
                        <ProgressBar Value="48" Height="10" Margin="0,12,0,0" Maximum="100" />
                        <TextBlock Text="Muted: False" Margin="0,16,0,0" Foreground="#A8B5C1" />
                    </StackPanel>
                </Border>
            </ItemsControl>
        </Border>

        <Border Grid.Row="2"
                Background="#1C232D"
                BorderBrush="#2E3945"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Playback Device" Foreground="#A8B5C1" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectedPlaybackDevice.Name, FallbackValue='No playback device selected'}" Foreground="#F4F8FB" FontSize="16" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Recording Device" Foreground="#A8B5C1" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectedRecordingDevice.Name, FallbackValue='No recording device selected'}" Foreground="#F4F8FB" FontSize="16" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
