<Window x:Class="MixerCompanionDesk.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer Companion Desk"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,24">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Mixer Companion Desk" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="System audio control and routing foundation" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Playback device">
                <ComboBox ItemsSource="{Binding PlaybackDevices}"
                          SelectedItem="{Binding SelectedPlaybackDevice, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name" />
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Recording device">
                <ComboBox ItemsSource="{Binding RecordingDevices}"
                          SelectedItem="{Binding SelectedRecordingDevice, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name" />
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Header="Master output">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding MasterVolume, StringFormat={}{0:0}%}" />
                    <ToggleButton Grid.Row="1" Grid.Column="0" Width="100" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,7" IsChecked="{Binding IsMuted, UpdateSourceTrigger=PropertyChanged}" Command="{Binding MuteCommand}" Content="Mute" />
                </Grid>
            </GroupBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Button Command="{Binding RefreshDevicesCommand}" Content="Refresh devices" />
                <Button Command="{Binding LoadSettingsCommand}" Content="Load settings" />
                <Button Command="{Binding SaveSettingsCommand}" Content="Save settings" />
            </StackPanel>
            <Border Grid.Row="2" Padding="12,9" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
